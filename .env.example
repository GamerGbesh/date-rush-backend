# ── Database ──────────────────────────────────────────────
# SQLite (default) or PostgreSQL (e.g. postgresql://user:pass@localhost:5432/date_rush)
# This is the default.
# Allows for postgresql
# if using postgresql
# DATABASE_URL=postgresql+psycopg://username:password@host:port
DATABASE_URL=sqlite:///./date_rush.db

# ── Matchmaking & Game Rules ──────────────────────────────
# Number of audience members required to form a game room (1 challenger + N audience)
# That's the default
GAME_ROOM_THRESHOLD=5

# Number of public question rounds per room
# That's the default
PUBLIC_QUESTION_ROUNDS=3

# Character limits
# That's the default
PRIVATE_QUESTION_MAX_LENGTH=500
CONTACT_MAX_LENGTH=100

# ── Phase Timers (in Seconds) ──────────────────────────────
# Challenger public question answering timer (e.g. 60s for testing, 480s for live 8 min)
# That's the default
QUESTIONING_TIMEOUT_SECONDS=60

# Public voting round timer
# That's the default
VOTING_TIMEOUT_SECONDS=30

# 1-on-1: Audience member question timer
# That's the default
ONE_ON_ONE_QUESTION_TIMEOUT_SECONDS=60

# 1-on-1: Challenger answer timer
# That's the default
ONE_ON_ONE_ANSWER_TIMEOUT_SECONDS=60

# 1-on-1: Audience vote timer (YES / NO)
# That's the default
ONE_ON_ONE_VOTE_TIMEOUT_SECONDS=30

# Final selection timer for challenger to pick a finalist
# That's the default
FINAL_SELECTION_TIMEOUT_SECONDS=60

# ── CORS Configuration ────────────────────────────────────
# Allowed origins for frontend access (JSON array format)
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
